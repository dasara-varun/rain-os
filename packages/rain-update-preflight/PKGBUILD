pkgname=rain-update-preflight
pkgver=1.2.1
pkgrel=1
pkgdesc="Rain OS pre-transaction update verification and safety wrapper"
arch=('any')
url="https://github.com/dasara-varun/rain-os"
license=('GPL3')
depends=('bash' 'coreutils' 'pacman')
source=(
  "bin/rain-update-preflight"
  "rain-update-preflight.desktop"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 "${srcdir}/bin/rain-update-preflight" "${pkgdir}/usr/bin/rain-update-preflight"
  install -Dm644 "${srcdir}/rain-update-preflight.desktop" "${pkgdir}/usr/share/applications/rain-update-preflight.desktop"
}
