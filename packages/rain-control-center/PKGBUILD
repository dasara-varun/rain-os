depends=('python' 'python-pillow' 'tk' 'polkit' 'bash')
source=(
  "bin/rain-control-center"
  "rain-control-center.desktop"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 "${srcdir}/bin/rain-control-center" "${pkgdir}/usr/bin/rain-control-center"
  install -Dm644 "${srcdir}/rain-control-center.desktop" "${pkgdir}/usr/share/applications/rain-control-center.desktop"
}
