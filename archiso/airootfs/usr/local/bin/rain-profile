#!/usr/bin/env bash
# Rain OS Profile Engine (Spec Pages 80-84 & 99)
# Manages system profiles: Core, Flow, Forge, Shield, Pocket
set -euo pipefail

CONF_FILE="/etc/rain-os/profile.conf"
BACKUP_DIR="/var/lib/rain/profiles"
mkdir -p "$BACKUP_DIR"

BOLD="\033[1m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

get_current_profile() {
    if [[ -f "$CONF_FILE" ]]; then
        grep "^RAIN_PROFILE=" "$CONF_FILE" | cut -d= -f2 || echo "core"
    else
        echo "core"
    fi
}

cmd_list() {
    local current
    current=$(get_current_profile)
    echo -e "${BOLD}${CYAN}Rain OS Profiles${RESET}"
    echo "=========================================================="
    
    local p_core="" p_flow="" p_forge="" p_shield="" p_pocket=""
    [[ "$current" == "core" ]] && p_core=" ${GREEN}(ACTIVE)${RESET}"
    [[ "$current" == "flow" ]] && p_flow=" ${GREEN}(ACTIVE)${RESET}"
    [[ "$current" == "forge" ]] && p_forge=" ${GREEN}(ACTIVE)${RESET}"
    [[ "$current" == "shield" ]] && p_shield=" ${GREEN}(ACTIVE)${RESET}"
    [[ "$current" == "pocket" ]] && p_pocket=" ${GREEN}(ACTIVE)${RESET}"

    echo -e "  ${BOLD}1. core${RESET}${p_core}"
    echo "     Standard balanced baseline. LTS kernel fallback, daily desktop stability."
    echo ""
    echo -e "  ${BOLD}2. flow${RESET}${p_flow}"
    echo "     High performance profile. Performance CPU governor, low swappiness (10), gamemode."
    echo ""
    echo -e "  ${BOLD}3. forge${RESET}${p_forge}"
    echo "     Developer workspace. High inotify limits (524288), container tuning, toolchains."
    echo ""
    echo -e "  ${BOLD}4. shield${RESET}${p_shield}"
    echo "     Hardened security profile. AppArmor enforced, restricted dmesg, strict firewall."
    echo ""
    echo -e "  ${BOLD}5. pocket${RESET}${p_pocket}"
    echo "     Low-resource & battery optimization. Powersave governor, aggressive memory reclaim."
    echo ""
    echo "Usage: rain-profile set <core|flow|forge|shield|pocket>"
}

cmd_status() {
    local current
    current=$(get_current_profile)
    echo -e "${BOLD}${CYAN}Rain OS Active Profile Status${RESET}"
    echo "=========================================================="
    echo -e "  Active Profile:       ${BOLD}${GREEN}${current}${RESET}"
    
    local gov="unknown"
    if command -v powerprofilesctl >/dev/null 2>&1; then
        gov=$(powerprofilesctl get 2>/dev/null || echo "standard")
    elif [[ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
        gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "standard")
    fi
    echo -e "  CPU Governor:         ${BOLD}${gov}${RESET}"

    local swap_val="60"
    if [[ -f /proc/sys/vm/swappiness ]]; then
        swap_val=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo "60")
    fi
    echo -e "  VM Swappiness:        ${BOLD}${swap_val}${RESET}"

    local inotify="8192"
    if [[ -f /proc/sys/fs/inotify/max_user_watches ]]; then
        inotify=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo "8192")
    fi
    echo -e "  Inotify Watches:      ${BOLD}${inotify}${RESET}"
    echo ""
}

cmd_set() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo "Error: target profile not specified." >&2
        cmd_list
        exit 1
    fi

    case "$target" in
        core|flow|forge|shield|pocket) ;;
        *)
            echo -e "${RED}Error: Invalid profile '$target'. Choose from core, flow, forge, shield, pocket.${RESET}" >&2
            exit 1
            ;;
    esac

    echo -e "${BOLD}Applying Rain OS profile:${RESET} ${CYAN}${target}${RESET}..."

    # Apply Governor
    if command -v powerprofilesctl >/dev/null 2>&1; then
        case "$target" in
            flow) powerprofilesctl set performance 2>/dev/null || true ;;
            pocket) powerprofilesctl set power-saver 2>/dev/null || true ;;
            *) powerprofilesctl set balanced 2>/dev/null || true ;;
        esac
    fi

    # Apply Kernel Sysctl Tunables if running with write access
    if [[ -w /proc/sys ]]; then
        case "$target" in
            flow)
                sysctl -w vm.swappiness=10 >/dev/null 2>&1 || true
                ;;
            forge)
                sysctl -w fs.inotify.max_user_watches=524288 >/dev/null 2>&1 || true
                sysctl -w vm.swappiness=30 >/dev/null 2>&1 || true
                ;;
            shield)
                sysctl -w kernel.dmesg_restrict=1 >/dev/null 2>&1 || true
                sysctl -w net.ipv4.tcp_syncookies=1 >/dev/null 2>&1 || true
                ;;
            pocket)
                sysctl -w vm.swappiness=100 >/dev/null 2>&1 || true
                sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1 || true
                ;;
            core)
                sysctl -w vm.swappiness=60 >/dev/null 2>&1 || true
                ;;
        esac
    fi

    # Write /etc/rain-os/profile.conf if writable
    if [[ -w /etc/rain-os ]]; then
        local perf_tier="generic"
        local sec_mode="baseline"
        [[ "$target" == "flow" ]] && perf_tier="performance"
        [[ "$target" == "pocket" ]] && perf_tier="powersave"
        [[ "$target" == "shield" ]] && sec_mode="shield"

        cat <<EOF > "$CONF_FILE"
RAIN_PROFILE=${target}
RAIN_PERFORMANCE_TIER=${perf_tier}
RAIN_KERNEL=linux-lts
RAIN_SNAPSHOT_BACKEND=btrfs
RAIN_SECURITY_MODE=${sec_mode}
EOF
    fi

    echo -e "${GREEN}Profile '${target}' applied successfully!${RESET}"
}

case "${1:-}" in
    list) cmd_list ;;
    status) cmd_status ;;
    set) shift; cmd_set "$@" ;;
    *) cmd_list ;;
esac
