#!/usr/bin/env bash
# Rain OS Installer Launcher with Integrated Desktop Selection
set -euo pipefail

echo "============================================================"
echo "          Rain OS System Installer (v1.3.2)                 "
echo "============================================================"

# 1. Desktop / Window Manager Selection Step (Vertical List)
if command -v rain-desktop-selector >/dev/null 2>&1; then
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "Launching Desktop Environment & Window Manager selector..."
        if ! rain-desktop-selector --install-mode; then
            echo "Installation wizard cancelled by user."
            exit 0
        fi
    else
        echo "Launching CLI Desktop Environment & Window Manager selector..."
        if ! rain-desktop-selector --install-mode --cli; then
            echo "Installation wizard cancelled by user."
            exit 0
        fi
    fi
elif [ -x "/usr/local/bin/rain-desktop-selector" ]; then
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if ! /usr/local/bin/rain-desktop-selector --install-mode; then
            echo "Installation wizard cancelled by user."
            exit 0
        fi
    else
        if ! /usr/local/bin/rain-desktop-selector --install-mode --cli; then
            echo "Installation wizard cancelled by user."
            exit 0
        fi
    fi
fi

# Log selected desktop environment
SELECTED_DESKTOP="cosmic"
if [ -f "/tmp/rain-install-desktop" ]; then
    SELECTED_DESKTOP="$(cat /tmp/rain-install-desktop | tr -d '[:space:]')"
elif [ -f "/etc/rain-os/install-desktop.conf" ]; then
    SELECTED_DESKTOP="$(grep -E '^DesktopId=' /etc/rain-os/install-desktop.conf | cut -d'=' -f2 | tr -d '[:space:]' || echo 'cosmic')"
fi
echo "Target system desktop environment: ${SELECTED_DESKTOP}"

# 2. Launch Graphical Calamares or Archinstall
if command -v calamares >/dev/null 2>&1; then
    echo "Starting Calamares graphical installer..."
    if [ "$(id -u)" -ne 0 ]; then
        if command -v pkexec >/dev/null 2>&1; then
            exec pkexec calamares "$@"
        else
            exec sudo calamares "$@"
        fi
    else
        exec calamares "$@"
    fi
elif command -v archinstall >/dev/null 2>&1; then
    echo "Starting Archinstall system installer..."
    TERM_CMD=""
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v cosmic-terminal >/dev/null 2>&1; then
            TERM_CMD="cosmic-terminal -e"
        elif command -v alacritty >/dev/null 2>&1; then
            TERM_CMD="alacritty -e"
        elif command -v konsole >/dev/null 2>&1; then
            TERM_CMD="konsole --new-window -e"
        elif command -v kitty >/dev/null 2>&1; then
            TERM_CMD="kitty"
        elif command -v xterm >/dev/null 2>&1; then
            TERM_CMD="xterm -e"
        fi
    fi
    if [ -n "$TERM_CMD" ]; then
        exec $TERM_CMD bash -c 'echo "Rain OS System Installer"; echo "============================================================"; sudo archinstall "$@"; ret=$?; echo ""; if [ $ret -eq 0 ]; then echo "Installation complete! Press Enter to close..."; else echo "Installer exited with code $ret. Press Enter to return..."; fi; read -r' _ "$@"
    fi
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo archinstall "$@"
    else
        exec archinstall "$@"
    fi
else
    echo "No installer found on system." >&2
    exit 1
fi
