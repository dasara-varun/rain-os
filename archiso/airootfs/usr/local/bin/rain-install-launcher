#!/usr/bin/env bash
# Rain OS Installer Launcher
set -euo pipefail

if command -v calamares >/dev/null 2>&1; then
    if [ "$(id -u)" -ne 0 ]; then
        if command -v pkexec >/dev/null 2>&1; then
            exec pkexec calamares "$@"
        else
            exec sudo calamares "$@"
        fi
    else
        exec calamares "$@"
    fi
elif command -v archinstall >/dev/null 2>&1; then
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v konsole >/dev/null 2>&1; then
            exec konsole --new-window -e sudo archinstall "$@"
        elif command -v xterm >/dev/null 2>&1; then
            exec xterm -e sudo archinstall "$@"
        fi
    fi
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo archinstall "$@"
    else
        exec archinstall "$@"
    fi
else
    echo "No installer found on system." >&2
    exit 1
fi
