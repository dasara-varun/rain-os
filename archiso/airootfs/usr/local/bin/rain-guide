#!/usr/bin/env bash
# Rain OS Offline Learning Hub & State-Aware Guide Viewer
set -euo pipefail

LESSONS_DIR="/opt/rain/lessons"
INDEX_FILE="/opt/rain/docs/guide-index.json"
RELEASE_FILE="/etc/rain-os/release.json"
PROFILE_FILE="/etc/rain-os/profile.conf"

# Fallback paths during development
if [[ ! -d "$LESSONS_DIR" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    LESSONS_DIR="$SCRIPT_DIR/../lessons"
    INDEX_FILE="$SCRIPT_DIR/../../../archiso/airootfs/opt/rain/docs/guide-index.json"
fi

BOLD="\033[1m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

cmd_list() {
    echo -e "${BOLD}${CYAN}Rain OS Learning Hub ? Available Lessons${RESET}"
    echo "=========================================================="
    if [[ -d "$LESSONS_DIR" ]]; then
        for f in "$LESSONS_DIR"/*.md; do
            if [[ -f "$f" ]]; then
                fname=$(basename "$f")
                title=$(head -n 1 "$f" | sed 's/^# *//')
                echo -e "  ${GREEN}?${RESET} ${BOLD}${fname}${RESET}: ${title}"
            fi
        done
    else
        echo "No lessons installed in $LESSONS_DIR."
    fi
    echo ""
    echo -e "${CYAN}Commands:${RESET}"
    echo "  rain-guide read <num|name>    Read a lesson (e.g. rain-guide read 01)"
    echo "  rain-guide search <query>     Search lesson contents"
    echo "  rain-guide status             Show guide and system profile facts"
    echo "  rain-guide doctor             Validate guide integrity"
    echo ""
}

cmd_read() {
    local target="${1:-}"
    local match=""
    if [[ -z "$target" ]]; then
        cmd_list
        exit 0
    fi
    for f in "$LESSONS_DIR"/*"$target"*.md; do
        if [[ -f "$f" ]]; then
            match="$f"
            break
        fi
    done
    if [[ -n "$match" && -f "$match" ]]; then
        if command -v glow >/dev/null 2>&1; then
            glow "$match"
        elif command -v bat >/dev/null 2>&1; then
            bat "$match"
        elif command -v less >/dev/null 2>&1; then
            less "$match"
        else
            cat "$match"
        fi
    else
        echo -e "${RED}Lesson '$target' not found.${RESET} Run 'rain-guide list' to see available lessons." >&2
        exit 1
    fi
}

cmd_search() {
    local query="${1:-}"
    if [[ -z "$query" ]]; then
        echo "Usage: rain-guide search <query>" >&2
        exit 1
    fi
    echo -e "${BOLD}${CYAN}Searching lessons for: '$query'${RESET}"
    echo "=========================================================="
    local count=0
    if [[ -d "$LESSONS_DIR" ]]; then
        for f in "$LESSONS_DIR"/*.md; do
            if grep -in "$query" "$f" >/dev/null 2>&1; then
                fname=$(basename "$f")
                echo -e "${GREEN}? $fname:${RESET}"
                grep -in -C 1 "$query" "$f" | head -n 6 | sed 's/^/    /'
                echo ""
                count=$((count + 1))
            fi
        done
    fi
    if [[ "$count" -eq 0 ]]; then
        echo "No occurrences found for '$query'."
    fi
}

cmd_status() {
    echo -e "${BOLD}${CYAN}Rain OS Guide & System Status${RESET}"
    echo "=========================================================="
    local os_ver="1.1.0 (Core)"
    if [[ -f "$RELEASE_FILE" ]] && command -v jq >/dev/null 2>&1; then
        os_ver=$(jq -r '.version // "1.1.0"' "$RELEASE_FILE")
    fi
    local profile="core"
    if [[ -f "$PROFILE_FILE" ]]; then
        profile=$(grep '^RAIN_PROFILE=' "$PROFILE_FILE" | cut -d= -f2 || echo "core")
    fi
    local guide_ver="1.1.0"
    if [[ -f "$INDEX_FILE" ]] && command -v jq >/dev/null 2>&1; then
        guide_ver=$(jq -r '.guide_version // "1.1.0"' "$INDEX_FILE")
    fi
    local fs_type="ext4"
    if command -v findmnt >/dev/null 2>&1; then
        fs_type=$(findmnt -n -o FSTYPE / 2>/dev/null || echo "unknown")
    fi

    echo -e "  Distribution:       ${BOLD}Rain OS${RESET}"
    echo -e "  Release Version:    ${BOLD}${os_ver}${RESET}"
    echo -e "  Active Profile:     ${BOLD}${profile}${RESET}"
    echo -e "  Guide Version:      ${BOLD}${guide_ver}${RESET} (offline-ready)"
    echo -e "  Root Filesystem:    ${BOLD}${fs_type}${RESET}"
    if [[ "$fs_type" == "btrfs" ]]; then
        echo -e "  Pre-update Safety:  ${GREEN}Active (Btrfs auto-snapshots enabled)${RESET}"
    else
        echo -e "  Pre-update Safety:  ${YELLOW}Standard (ext4/other filesystem detected)${RESET}"
    fi
    echo ""
}

cmd_doctor() {
    echo -e "${BOLD}${CYAN}Rain OS Guide Doctor ? Health Check${RESET}"
    echo "=========================================================="
    local errors=0

    # 1. Check lessons directory
    if [[ -d "$LESSONS_DIR" ]]; then
        local count
        count=$(find "$LESSONS_DIR" -name "*.md" | wc -l)
        echo -e "  [${GREEN}PASS${RESET}] Lessons directory present ($count lessons found)"
    else
        echo -e "  [${RED}FAIL${RESET}] Lessons directory missing ($LESSONS_DIR)"
        errors=$((errors + 1))
    fi

    # 2. Check index manifest
    if [[ -f "$INDEX_FILE" ]]; then
        if command -v jq >/dev/null 2>&1; then
            if jq empty "$INDEX_FILE" 2>/dev/null; then
                echo -e "  [${GREEN}PASS${RESET}] Guide index manifest is valid JSON"
            else
                echo -e "  [${RED}FAIL${RESET}] Guide index manifest syntax error"
                errors=$((errors + 1))
            fi
        else
            echo -e "  [${GREEN}PASS${RESET}] Guide index manifest present"
        fi
    else
        echo -e "  [${YELLOW}WARN${RESET}] Guide index manifest not found ($INDEX_FILE)"
    fi

    # 3. Check Btrfs snapshot helper
    if [[ -x "/usr/local/bin/rain-btrfs-snapshot" ]]; then
        echo -e "  [${GREEN}PASS${RESET}] Pre-update snapshot helper installed"
    else
        echo -e "  [${YELLOW}INFO${RESET}] rain-btrfs-snapshot helper not in /usr/local/bin"
    fi

    # 4. Check hardware reporter
    if [[ -x "/usr/local/bin/rain-hardware-report" ]]; then
        echo -e "  [${GREEN}PASS${RESET}] Hardware detection wizard installed"
    else
        echo -e "  [${YELLOW}INFO${RESET}] rain-hardware-report wizard not in /usr/local/bin"
    fi

    echo ""
    if [[ "$errors" -eq 0 ]]; then
        echo -e "${GREEN}${BOLD}Result: System guide and offline learning hub are healthy!${RESET}"
    else
        echo -e "${RED}${BOLD}Result: $errors errors detected. Please check configuration.${RESET}"
        exit 1
    fi
}

case "${1:-}" in
    list) cmd_list ;;
    read) shift; cmd_read "$@" ;;
    search) shift; cmd_search "$@" ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    help|--help|-h) cmd_list ;;
    *) cmd_list ;;
esac
