#!/usr/bin/env bash
# Rain OS Live User and Desktop Initialization
set -euo pipefail

LIVE_USER="liveuser"
USER_HOME="/home/$LIVE_USER"
USER_DESKTOP="$USER_HOME/Desktop"

if ! id "$LIVE_USER" >/dev/null 2>&1; then
    useradd -m -g users -G wheel,video,audio,storage,network,power,autologin -s /bin/bash "$LIVE_USER"
else
    usermod -aG wheel,video,audio,storage,network,power,autologin "$LIVE_USER" 2>/dev/null || true
fi

# Ensure liveuser and root have passwordless privileges and known fallback passwords
passwd -d "$LIVE_USER" >/dev/null 2>&1 || true
echo "$LIVE_USER:$LIVE_USER" | chpasswd >/dev/null 2>&1 || true
passwd -d root >/dev/null 2>&1 || true
echo "root:rain" | chpasswd >/dev/null 2>&1 || true

# Ensure sudo rights without password for wheel
mkdir -p /etc/sudoers.d
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/00_g_wheel
chmod 440 /etc/sudoers.d/00_g_wheel

# Populate user home from /etc/skel
if [ -d /etc/skel ]; then
    mkdir -p "$USER_HOME"
    cp -rT /etc/skel "$USER_HOME"
fi

# Ensure all desktop shortcuts are executable
if [ -d "$USER_DESKTOP" ]; then
    chmod +x "$USER_DESKTOP"/*.desktop 2>/dev/null || true
fi

# Clean Desktop Experience: No intrusive popup windows on boot
# Desktop is kept clean with only Install Rain OS to Disk and Learning Hub.
AUTOSTART_DIR="$USER_HOME/.config/autostart"
mkdir -p "$AUTOSTART_DIR"
rm -f "$AUTOSTART_DIR"/*.desktop 2>/dev/null || true

# Setup COSMIC Desktop default 4K wallpaper config
COSMIC_BG_DIR="$USER_HOME/.config/cosmic/com.system76.CosmicBackground/v1"
mkdir -p "$COSMIC_BG_DIR"
cat << 'EOF' > "$COSMIC_BG_DIR/all"
(
    output: "all",
    source: Path("/usr/share/wallpapers/rain-os/rain-wallpaper-01.jpg"),
    filter_by_theme: false,
    rotation_frequency: 0,
    scaling_mode: Zoom,
    sampling_method: Lanczos,
)
EOF

# Setup KDE Plasma default 4K wallpaper config
PLASMA_CONFIG_DIR="$USER_HOME/.config"
mkdir -p "$PLASMA_CONFIG_DIR"
cat << 'EOF' > "$PLASMA_CONFIG_DIR/plasma-org.kde.plasma.desktop-appletsrc"
[Containments][1][Wallpaper][org.kde.image][General]
Image=file:///usr/share/wallpapers/rain-os/rain-wallpaper-01.jpg
SlidePaths=/usr/share/wallpapers/rain-os/
EOF

chown -R "$LIVE_USER:users" "$USER_HOME"

exit 0
