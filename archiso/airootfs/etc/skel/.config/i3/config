# Rain OS i3-wm Configuration
# Super = Mod4 (Windows key)
set $mod Mod4

font pango:DejaVu Sans Mono 10

# Autostart
exec --no-startup-id picom -b
exec --no-startup-id feh --bg-fill /usr/share/wallpapers/rain-os/rain-wallpaper-4k.jpg
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1

# Drag floating windows
floating_modifier $mod

# Keybindings
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+d exec rofi -show drun
bindsym $mod+s exec rain-desktop-selector
bindsym $mod+c exec rain-control-center

# Navigation
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Layouts
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Restart i3
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes, exit i3' 'i3-msg exit'"

# Urban Rain Colors: class border bground text indicator child_border
client.focused          #e83e38 #282d37 #f0f6fc #e83e38 #e83e38
client.focused_inactive #383e4c #1e222b #9ba3af #383e4c #383e4c
client.unfocused        #282d37 #1e222b #9ba3af #282d37 #282d37
client.urgent           #e83e38 #e83e38 #ffffff #e83e38 #e83e38

# Status Bar
bar {
    status_command i3status
    position top
    colors {
        background #1e222b
        statusline #f0f6fc
        separator  #383e4c

        focused_workspace  #e83e38 #e83e38 #ffffff
        active_workspace   #383e4c #282d37 #f0f6fc
        inactive_workspace #1e222b #1e222b #9ba3af
        urgent_workspace   #e83e38 #e83e38 #ffffff
    }
}
